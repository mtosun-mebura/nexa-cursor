{
  "name": "nexa-promo-videos",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion promo videos for Nexa Suite / NexaTaxi",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "studio": "remotion studio src/index.ts",
    "build": "remotion bundle src/index.ts",
    "render:promo": "remotion render src/index.ts NexaProductPromo out/nexa-product-promo.mp4",
    "render:teaser": "remotion render src/index.ts NexaAppTeaser out/nexa-app-teaser.mp4",
    "render:all": "npm run render:promo && npm run render:teaser",
    "render:props": "node scripts/render-with-props.mjs",
    "player:dev": "vite --config vite.player.config.ts",
    "player:build": "vite build --config vite.player.config.ts",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "4.0.544",
    "@remotion/player": "4.0.544",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.544"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  }
}
